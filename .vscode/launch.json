{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "attach",
      "name": "Debug already-running process",
      "pid": "${command:pickMyProcess}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'leanterm'",
      "cargo": {
        "args": ["build", "--bin=leanterm"],
        "filter": {
          "name": "leanterm",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug MacOS executable",
      "preLaunchTask": "build_leantermlocal",
      "program": "${workspaceFolder}/target/debug/bundle/osx/LeantermLocal.app/Contents/MacOS/leanterm",
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'leanterm' with fast_dev",
      "cargo": {
        "args": ["build", "--bin=leanterm", "--features=fast_dev"],
        "filter": {
          "name": "leanterm",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'leanterm' with with_local_server",
      "cargo": {
        "args": ["build", "--bin=leanterm", "--features=with_local_server"],
        "filter": {
          "name": "leanterm",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug MacOS executable with fast_dev",
      "env": {
        "RUST_BACKTRACE": "1"
      },
      "preLaunchTask": "build_leantermlocal_fastdev",
      "program": "${workspaceFolder}/target/debug/bundle/osx/LeantermLocal.app/Contents/MacOS/leanterm",
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in executable 'leanterm'",
      "cargo": {
        "args": ["test", "--no-run", "--bin=leanterm", "--package=leanterm"],
        "filter": {
          "name": "leanterm",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug integration tests in executable 'integration'",
      "cargo": {
        "args": ["build", "--bin=integration", "--package=leanterm"],
        "env": {
          "LEANTERM_UI_USE_REAL_DISPLAY_IN_INTEGRATION_TESTS": "1"
        },
        "filter": {
          "name": "integration",
          "kind": "bin"
        }
      },
      "args": ["test_waterfall_input"],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in library 'leanterm_ui'",
      "cargo": {
        "args": ["test", "--no-run", "--lib", "--package=leanterm_ui"],
        "filter": {
          "name": "leanterm_ui",
          "kind": "lib"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    }
  ]
}
