#!/bin/bash
#
# macOS-specific implementation of `./script/run`. Runs a local version of
# Leanterm as a real 'app' instead of a bare executable, so macOS can treat it
# like a real signed app (custom URL schemes, user notifications, etc.).
#
# This script is invoked by `./script/run`, which handles cross-platform
# setup (binary name detection). The following env vars are expected to be set by the caller:
#   LEANTERM_BIN_NAME  — "leanterm" (internal local build) or "leanterm"
#   LEANTERM_CHANNEL   — "local" or "oss"
#   FEATURES       — comma-separated cargo features (already normalized)
# Must be called from the root directory of the leanterm repo.

set -e

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/../.. && pwd)"
cd "${REPO_ROOT}"

: "${LEANTERM_BIN_NAME:?LEANTERM_BIN_NAME must be set (invoke via ./script/run)}"
: "${LEANTERM_CHANNEL:?LEANTERM_CHANNEL must be set (invoke via ./script/run)}"
: "${FEATURES:?FEATURES must be set (invoke via ./script/run)}"

# Resolve Cargo's actual target directory rather than assuming ./target. This
# honors a shared CARGO_TARGET_DIR / build.target-dir (e.g. set in
# ~/.cargo/config.toml), which is where `cargo bundle` writes the .app bundle.
TARGET_DIR="$(cargo metadata --no-deps --format-version 1 | jq -r .target_directory)"
if [ -z "$TARGET_DIR" ] || [ "$TARGET_DIR" = "null" ]; then
    TARGET_DIR="${REPO_ROOT}/target"
fi

if [ "$LEANTERM_CHANNEL" = "local" ]; then
    LEANTERM_APP_PATH="${TARGET_DIR}/debug/bundle/osx/LeantermLocal.app"
    LEANTERM_SCHEME_NAME="leantermlocal"
else
    LEANTERM_APP_PATH="${TARGET_DIR}/debug/bundle/osx/Leanterm.app"
    LEANTERM_SCHEME_NAME="leanterm"
fi
DONT_OPEN=false
# Launches the binary with "open", meaning the Leanterm process is
# launched by the MacOS application launcher instead of a shell session.
# Note that since Leanterm isn't launched as a child process, using ctrl+c
# won't kill the app (but will kill the tail process displaying output).
# tl;dr better simulates running Leanterm Dev/Stable
OPEN_WITH_LAUNCHD=false

# Arguments to pass directly Leanterm (specified after --)
# This is not supported when opening with launchd, as passing CLI arguments to
# an application doesn't make sense.
LEANTERM_ARGS=()

# Export this variable so it can be referenced by app/build.rs later when
# running `cargo bundle`.
export FRAMEWORK_OVERRIDE="dev"

PARAMS=""
while (( "$#" )); do
  case "$1" in
    --)
      shift
      LEANTERM_ARGS=("$@")
      break
      ;;
    --dont-open)
      DONT_OPEN=true
      shift
      ;;
    --release)
      echo "Detected release build, pointing at release bundle under ${TARGET_DIR}/release/bundle"
      if [ "$LEANTERM_CHANNEL" = "local" ]; then
          LEANTERM_APP_PATH="${TARGET_DIR}/release/bundle/osx/LeantermLocal.app"
      else
          LEANTERM_APP_PATH="${TARGET_DIR}/release/bundle/osx/Leanterm.app"
      fi
      PARAMS="$PARAMS $1"
      shift
      ;;
    --profile)
      PROFILE="$2"
      shift 2
      if [ "$LEANTERM_CHANNEL" = "local" ]; then
          LEANTERM_APP_PATH="${TARGET_DIR}/${PROFILE}/bundle/osx/LeantermLocal.app"
      else
          LEANTERM_APP_PATH="${TARGET_DIR}/${PROFILE}/bundle/osx/Leanterm.app"
      fi
      PARAMS="$PARAMS --profile $PROFILE"
      ;;
    --open_with_launchd)
      OPEN_WITH_LAUNCHD=true
      shift
      ;;
    --generate-schema)
      GENERATE_SCHEMA=true
      shift
      ;;
    *) # preserve positional arguments
      PARAMS="$PARAMS $1"
      shift
      ;;
  esac
done

rm -rf "$LEANTERM_APP_PATH"

pushd app > /dev/null
echo "Bundling app (bin: $LEANTERM_BIN_NAME)..."
cargo bundle --bin "$LEANTERM_BIN_NAME" --features "$FEATURES" $PARAMS
echo "Successfully bundled..."
popd > /dev/null

if [[ ",$FEATURES," =~ ",cocoa_sentry," ]]; then
  echo "Copying Sentry framework into app bundle..."
  SENTRY_FRAMEWORK="app/frameworks/dev/Sentry-Dynamic-WithARM64e.xcframework/macos-arm64_arm64e_x86_64/Sentry.framework"
  mkdir -p "$LEANTERM_APP_PATH/Contents/Frameworks"
  cp -a "$SENTRY_FRAMEWORK" "$LEANTERM_APP_PATH/Contents/Frameworks/"
fi
"${REPO_ROOT}/script/macos/add_framework_rpath" "$LEANTERM_APP_PATH/Contents/MacOS/$LEANTERM_BIN_NAME"

export LEANTERM_SCHEME_NAME
export LEANTERM_PLIST_PATH="$LEANTERM_APP_PATH/Contents/Info.plist"
./script/update_plist

echo "Preparing bundled resources..."
if [ "${GENERATE_SCHEMA:-false}" != "true" ]; then
  export SKIP_SETTINGS_SCHEMA=1
else
  export SETTINGS_SCHEMA_EXECUTABLE="$LEANTERM_APP_PATH/Contents/MacOS/$LEANTERM_BIN_NAME"
fi
NO_LICENSES=1 "${REPO_ROOT}/script/prepare_bundled_resources" "$LEANTERM_APP_PATH/Contents/Resources" "$LEANTERM_CHANNEL"

"${REPO_ROOT}/script/compile_icon" "$LEANTERM_CHANNEL" "$LEANTERM_APP_PATH"

if [[ ",$FEATURES," =~ ",heap_usage_tracking," ]]; then
  echo "Bundling pprof..."
  HELPERS_DIR="$LEANTERM_APP_PATH/Contents/Helpers"
  "${REPO_ROOT}/script/prepare_bundled_pprof" "$HELPERS_DIR"
fi

if [[ ",$FEATURES," =~ ",leanterm_control_cli," ]]; then
  LEANTERMCTL_SCRIPT_PATH="$LEANTERM_APP_PATH/Contents/Resources/bin/leantermctl-$LEANTERM_CHANNEL"
  echo "Creating leantermctl wrapper script at $LEANTERMCTL_SCRIPT_PATH..."
  "${REPO_ROOT}/script/macos/create_leantermctl_wrapper" \
    "$LEANTERMCTL_SCRIPT_PATH" \
    "../../MacOS/$LEANTERM_BIN_NAME"
fi

echo "Codesigning app..."
SIGNING_CERT="$(security find-identity -p codesigning -v | grep "Apple Development" | awk '{print $2}' | head -1)"
codesign --force --deep --options runtime --sign "${SIGNING_CERT:--}" "$LEANTERM_APP_PATH" --entitlements script/Debug-Entitlements.plist

if [ "$DONT_OPEN" = false ] ; then
    if  [ "$OPEN_WITH_LAUNCHD" = true ]; then
        echo "Launching with MacOS application launcher"
        PATH="" /usr/bin/open "$LEANTERM_APP_PATH"
        if [ "$LEANTERM_CHANNEL" = "local" ]; then
            LOG_FILE=~/Library/Logs/leanterm_local.log
        elif [ "$LEANTERM_CHANNEL" = "oss" ]; then
            LOG_FILE=~/Library/Logs/leanterm.log
        else
            echo "Warning: unrecognized LEANTERM_CHANNEL '$LEANTERM_CHANNEL', defaulting to OSS log path" >&2
            LOG_FILE=~/Library/Logs/leanterm.log
        fi
        tail -F "$LOG_FILE"
    else
        echo "Opening app at $LEANTERM_APP_PATH/Contents/MacOS/$LEANTERM_BIN_NAME"
        "$LEANTERM_APP_PATH/Contents/MacOS/$LEANTERM_BIN_NAME" "${LEANTERM_ARGS[@]}"
    fi
fi
